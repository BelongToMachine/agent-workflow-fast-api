VITE_FASTAPI_URL=http://127.0.0.1:8000
VITE_WORKSPACE_ID=00000000-0000-0000-0000-000000000001
# Set to local_session to use FastAPI's HttpOnly session cookie in local or production builds.
# When enabled, the backend must use AUTH_MODE=dual or AUTH_MODE=local_session.
# Leave unset for the development OIDC simulator or set to preview for Logto.
# VITE_AUTH_MODE=local_session
# MVP mode: keep one configured workspace until workspace selection is shipped.
VITE_SINGLE_WORKSPACE_MODE=true

# Optional Logto SPA authentication. Enable by filling all three values.
# Do not add a client secret to a Vite environment file.
# VITE_LOGTO_ENDPOINT=https://your-tenant.logto.app
# VITE_LOGTO_APP_ID=your-spa-app-id
# VITE_LOGTO_API_RESOURCE=https://api.asianode.example.com

# Optional: fastapi-direct uses the legacy token endpoint instead of the Vite proxy.
# NEXT_PUBLIC_API_MODE=fastapi-proxy
# Optional browser-visible FastAPI settings. Vite also falls back to VITE_FASTAPI_URL.
# NEXT_PUBLIC_FASTAPI_BASE_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_USE_FASTAPI_BACKEND=1
