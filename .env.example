ASIANODE_APP_NAME=Asianode FastAPI
ASIANODE_ENVIRONMENT=development
ASIANODE_DEBUG=true

# The FastAPI service also reads the repository root .env.local during local development.
DEEPSEEK_API_KEY=****
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-chat
CHAT_PROVIDER_TIMEOUT_SECONDS=60
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
POSTGRES_URL=postgresql://asianode:asianode@127.0.0.1:5432/asianode
REDIS_URL=redis://127.0.0.1:6379/0
RESUMABLE_STREAM_TTL_SECONDS=86400
KNOWLEDGE_BASE_ENTITY_ENABLED=false
KNOWLEDGE_GRANTS_ENABLED=false
KNOWLEDGE_INGESTION_ENABLED=false
KNOWLEDGE_EMBEDDINGS_ENABLED=false
EMBEDDING_API_KEY=****
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER_TIMEOUT_SECONDS=60
KNOWLEDGE_STORAGE_PROVIDER=local
KNOWLEDGE_STORAGE_DIR=storage/knowledge
# Required when KNOWLEDGE_STORAGE_PROVIDER=s3.
# KNOWLEDGE_S3_BUCKET=asianode-knowledge
# KNOWLEDGE_S3_ENDPOINT_URL=https://s3.example.com
# KNOWLEDGE_S3_REGION=us-east-1
# KNOWLEDGE_S3_ACCESS_KEY_ID=****
# KNOWLEDGE_S3_SECRET_ACCESS_KEY=****

# Web chat image attachments. Keep disabled until storage and public URL access are configured.
CHAT_ATTACHMENTS_ENABLED=false
ATTACHMENT_STORAGE_PROVIDER=local
ATTACHMENT_STORAGE_DIR=storage/attachments
ATTACHMENT_MAX_FILE_BYTES=5242880
ATTACHMENT_URL_TTL_SECONDS=3600
# ATTACHMENT_PUBLIC_BASE_URL=https://api.example.com

# OIDC / Logto access-token validation.
# Keep false only for local development. Production and staging require auth
# automatically, even when AUTH_REQUIRED is omitted.
AUTH_REQUIRED=false
AUTH_ISSUER=https://your-tenant.logto.app/oidc
AUTH_AUDIENCE=https://api.asianode.example.com
AUTH_JWKS_URL=https://your-tenant.logto.app/oidc/jwks
AUTH_ALGORITHMS=RS256

# Optional development-only browser direct-mode token secret.
DEV_DIRECT_AUTH_SECRET=change-me-in-development

# Use Redis for rate-limit counters when REDIS_URL is available; fall back to process-local limits on failure.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REDIS_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Opt-in local SQLAdmin preview. Read-only and disabled by default.
# SQLADMIN_ENABLED=true
# SQLADMIN_USERNAME=admin
# SQLADMIN_PASSWORD=change-me-locally
# SQLADMIN_SECRET_KEY=use-a-long-random-local-secret
