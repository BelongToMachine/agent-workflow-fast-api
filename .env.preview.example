APP_NAME=Asianode FastAPI Preview
ENVIRONMENT=staging
DEBUG=false

# Fill in staging-only values. Do not commit the real file as .env.preview.
DEEPSEEK_API_KEY=replace-with-preview-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-chat
CHAT_PROVIDER_TIMEOUT_SECONDS=60

# PostgreSQL is intentionally external for this 2 GB relay VPS.
POSTGRES_URL=postgresql://preview_user:replace-with-password@postgres.example.internal:5432/asianode_preview
REDIS_URL=redis://redis:6379/0
RESUMABLE_STREAM_TTL_SECONDS=86400

# Replace with the exact preview frontend origin(s), comma-separated.
CORS_ORIGINS=https://preview.example.com

DEFAULT_WORKSPACE_ID=00000000-0000-0000-0000-000000000001
DEFAULT_WORKSPACE_ROLE=viewer
SINGLE_WORKSPACE_MODE=true

AUTH_REQUIRED=true
AUTH_MODE=logto
AUTH_ISSUER=https://your-tenant.logto.app/oidc
AUTH_AUDIENCE=https://api-preview.example.com
AUTH_JWKS_URL=https://your-tenant.logto.app/oidc/jwks
AUTH_ALGORITHMS=RS256
AUTH_SECRET=replace-with-at-least-32-random-characters

KNOWLEDGE_BASE_ENTITY_ENABLED=false
KNOWLEDGE_GRANTS_ENABLED=false
KNOWLEDGE_INGESTION_ENABLED=false
KNOWLEDGE_EMBEDDINGS_ENABLED=false
KNOWLEDGE_STORAGE_PROVIDER=local
KNOWLEDGE_STORAGE_DIR=storage/knowledge

CHAT_ATTACHMENTS_ENABLED=false
ATTACHMENT_STORAGE_PROVIDER=local
ATTACHMENT_STORAGE_DIR=storage/attachments

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REDIS_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

SQLADMIN_ENABLED=false
