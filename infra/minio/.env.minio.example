# Copy this file to the target VPS as .env.minio and chmod it to 0600.
# Never commit the copied file or put the values below in an application release.

# Compose interpolation and project identity.
MINIO_PROJECT_NAME=asianode-minio-production
MINIO_ENV_FILE=/home/asianode/asianode-production/infra/minio/.env.minio
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-06T17-38-46Z
MINIO_DATA_DIR=/home/asianode/asianode-production/shared/minio-data
MINIO_API_HOST_PORT=19000
MINIO_CONSOLE_HOST_PORT=19001

# Infrastructure administrator credentials.
# Generate unique values, for example with: openssl rand -hex 32
MINIO_ROOT_USER=replace-with-a-unique-admin-name
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password

# Optional public URLs used when Caddy is configured. The API container on the
# same Docker network still uses http://minio:9000, not these browser URLs.
# MINIO_SERVER_URL=https://storage.asianodeatlas.com
# MINIO_BROWSER_REDIRECT_URL=https://minio-console.asianodeatlas.com

# The bucket and application access key are created separately with mc. Do not
# give the application the root credentials above.
# MINIO_BUCKET=asianode-knowledge-production
# MINIO_APP_USER=asianode-api-production
