# Public build-time values only. Vite embeds these values into the browser
# bundle. Do not put passwords, API keys, or other secrets in this file.
FRONTEND_ENVIRONMENT=staging
# Current staging is SSH-only. Forward the API port to the same local port
# before opening the frontend in a browser; replace this with the staging API
# hostname when a staging Tunnel/domain is provisioned.
FRONTEND_API_URL=http://127.0.0.1:18000
VITE_WORKSPACE_ID=00000000-0000-0000-0000-000000000001
VITE_SINGLE_WORKSPACE_MODE=true
NEXT_PUBLIC_API_MODE=fastapi-direct
NEXT_PUBLIC_USE_FASTAPI_BACKEND=1

# Keep the host binding private until the staging Tunnel is approved.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_HOST_PORT=18100
